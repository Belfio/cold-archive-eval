{
  "extends": "./.sst/platform/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "sst.config.ts",
    "sst-env.d.ts",
    "infra/**/*.ts",
    "functions/**/*.ts",
    "core/**/*.ts"
  ]
}
